# Your MetaMask wallet private key (no 0x prefix)
# NEVER share this or commit .env to git
PRIVATE_KEY=your_private_key_here

# Your friend's Ethereum wallet address
FRIEND_WALLET_ADDRESS=0xFriendWalletAddressHere

# Your friend's WhatsApp phone number with country code, no + or spaces
# Example: US number +1 (555) 123-4567 becomes 15551234567
FRIEND_PHONE=15551234567

# Amount of ETH (or native token) to send per day
TRANSFER_AMOUNT_ETH=0.001

# Ethereum RPC endpoint
# Free options: https://infura.io, https://alchemy.com
# Low-fee networks: Polygon = https://polygon-rpc.com, Base = https://mainnet.base.org
RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
