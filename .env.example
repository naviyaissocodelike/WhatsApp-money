# Your MetaMask wallet private key (no 0x prefix) — NEVER commit this
PRIVATE_KEY=your_private_key_here

# Your friend's Ethereum wallet address
FRIEND_WALLET_ADDRESS=0xFriendWalletAddressHere

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Your friend's Telegram user ID (they can get it by messaging @userinfobot)
FRIEND_TELEGRAM_ID=987654321

# USDC contract address for your chosen network:
#   Ethereum mainnet : 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
#   Polygon          : 0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
#   Base             : 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Arbitrum         : 0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# RPC endpoint for the same network
#   Polygon (free, low fees): https://polygon-rpc.com
#   Ethereum: https://mainnet.infura.io/v3/YOUR_KEY
RPC_URL=https://polygon-rpc.com

# Cooldown in seconds between transfers (prevents spam)
# Default: 60
COOLDOWN_SECONDS=60
